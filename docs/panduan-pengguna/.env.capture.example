# Salin file ini menjadi `.env.capture` (TIDAK di-commit, sudah masuk .gitignore),
# lalu isi nilainya. Dipakai oleh capture-screens.mjs untuk menangkap screenshot asli.

# URL aplikasi SmartPatrol ter-deploy (default sudah https://smartpatrols.vercel.app).
# Kosongkan untuk pakai default, atau isi bila berbeda.
SMARTPATROL_URL=https://smartpatrols.vercel.app

# Akun ADMIN
SP_ADMIN_EMAIL=
SP_ADMIN_PASSWORD=

# Akun PETUGAS (user)
SP_PETUGAS_EMAIL=
SP_PETUGAS_PASSWORD=

# (opsional) Akun PIC bila ada — agar panduan PIC juga memakai screenshot asli
# SP_PIC_EMAIL=
# SP_PIC_PASSWORD=

# (opsional) HEADFUL=1 untuk melihat browser saat capture (debug)
# HEADFUL=1
